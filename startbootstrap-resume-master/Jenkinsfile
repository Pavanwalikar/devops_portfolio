pipeline {
    agent any

    stages {
        stage('Check Jenkins') {
            steps {
                echo 'Jenkins Pipeline is working!'
            }
        }

        stage('Check Docker') {
            steps {
                sh 'docker --version'
                sh 'docker ps'
            }
        }

        stage('Check Workspace') {
            steps {
                sh 'pwd'
                sh 'ls -la'
            }
        }
    }
}
